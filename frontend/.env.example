# Leave empty (recommended): the app calls /api on its own origin.
#  - dev: Vite proxies /api to http://localhost:8000
#  - prod: CloudFront routes /api/* to the backend (see infra/cloudfront-and-s3-notes.md)
# Only set this if your API lives on a different domain, e.g. https://api.example.com
VITE_API_URL=
