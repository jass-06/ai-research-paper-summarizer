# Copy to .env  ( cp .env.example .env )  — .env is git-ignored, never commit it.

# ---------- AI (required for real summaries) ----------
# groq = real AI (free key at https://console.groq.com/keys)
# mock = no key needed, placeholder output (good for a first test / demos / CI)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# How many characters of the paper are sent to the AI (head + conclusion are kept)
AI_MAX_INPUT_CHARS=14000

# Look up REAL related papers on arXiv (free, no key)
ENABLE_ARXIV=true

# ---------- Database ----------
# Leave empty for zero-setup SQLite (stored in backend/data/local.db)
DATABASE_URL=
# Docker Compose / local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_research
# AWS RDS:
# DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxx.eu-central-1.rds.amazonaws.com:5432/ai_research

# ---------- Storage ----------
# auto = S3 if AWS_S3_BUCKET is set, otherwise local disk (backend/data/storage)
STORAGE_BACKEND=auto
AWS_S3_BUCKET=
AWS_REGION=eu-central-1
# Only needed on your laptop. On EC2/Lambda use an IAM ROLE instead of keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Processing ----------
# true  = process in the backend (no AWS needed)
# false = hand off to the AWS Lambda function below
LOCAL_PROCESSING=true
AWS_LAMBDA_FUNCTION_NAME=paper-processor

# ---------- Web ----------
# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
